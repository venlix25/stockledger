# ──────────────────────────────────────────────────
# StockLedger — Environment Variable Template
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.
# ──────────────────────────────────────────────────

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# NOWPayments — use sandbox keys for local dev, live keys for production
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret

# Set to "sandbox" for local/staging, omit or set to "live" for production
NOWPAYMENTS_ENV=sandbox

# App base URL — used to build IPN callback URLs
# For local dev: http://localhost:3000
# For production Vercel: https://your-project.vercel.app
APP_BASE_URL=https://your-project.vercel.app
